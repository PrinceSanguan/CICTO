APP_NAME=CICTO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# CICTO runs on both PostgreSQL and MySQL/MariaDB. Uncomment one block.
# Schema is kept driver-agnostic on purpose -- see docs/DATABASE.md.

# --- PostgreSQL (default) ---
# Use a dedicated, password-authenticated role -- not a superuser and not
# `trust` auth. Postgres.app rejects `trust` for the dev server's child process,
# and no production host will offer it either. Create one with:
#   createuser --pwprompt cicto && createdb -O cicto cicto
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cicto
DB_USERNAME=cicto
DB_PASSWORD=

# --- MySQL / MariaDB ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cicto
# DB_USERNAME=root
# DB_PASSWORD=

# --- SQLite (zero-setup local dev) ---
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Outgoing mail ---
# CICTO answered client question B3 on 2026-08-20: they will not supply email
# credentials or configuration for this system, school project or not, and they
# recommend an external service -- Google SMTP by name -- for anything this
# application needs to send.
#
# SUPERSEDED 2026-08-23. The operator took that recommendation. There is now a
# Gmail account with a 16-character App Password on it, and the real host sends
# for real: it was proved with an authenticated STARTTLS handshake and with a
# message that actually arrived, not with a config dump. Password reset, support
# tickets and the registration verification link all leave the server there.
#
# This file still ships the block DISABLED, and should stay that way. A
# checked-in example that turns mail on by accident is how a repository ends up
# carrying credentials; the working values live only in the host's own .env,
# which is not in git. What follows is the recipe that is known to work, for
# whoever sets up the next host.
#
# What the application does while this says `log`:
#   - "Forgot password" refuses rather than pretending. No reset link is minted
#     and the page says why.
#   - Support tickets are written to the log and the page says they were not
#     delivered.
#   - Registration marks the new account verified on the spot, because on this
#     mailer the confirmation link could never be delivered and `verified` on
#     the protected routes is a real gate now. See App\Actions\Fortify\
#     CreateNewUser for why that is parity rather than a weakening.
#   - Deadline notices are in-app only.
# On any mailer, a Super Admin setting a new password on /super-admin/users --
# or `php artisan cicto:user <email> --reset-password` when nobody can sign in
# at all -- remains the supported way back into a locked-out account. With mail
# live it is no longer the only way in, and it is still the right advice for a
# user who cannot receive mail.
#
# `php artisan cicto:host-check` reports the state of all of this on the real
# host.
MAIL_MAILER=log

# Keeps rendered messages out of the shared application log while the mailer is
# `log` -- that log holds working password-reset links. See config/logging.php.
# It costs nothing under `smtp`, so it stays set on the live host too: a fall
# back to `log` then cannot spill reset links into the shared log.
MAIL_LOG_CHANNEL=mail

# TO TURN MAIL ON, EDIT THE VALUES BELOW IN PLACE. Do not paste a second copy of
# these keys anywhere in this file: dotenv takes the LAST assignment of a
# duplicated key, so a pasted block above these lines is silently ignored and
# you end up with MAIL_MAILER=smtp still pointing at 127.0.0.1:2525 -- a mailer
# the application believes is working, minting reset tokens that go nowhere.
#
# The known-good configuration, the one the host has been running since
# 2026-08-23:
#   MAIL_MAILER      smtp
#   MAIL_HOST        smtp.gmail.com
#   MAIL_PORT        587
#   MAIL_SCHEME      null -- 587 is STARTTLS, see below
#   MAIL_USERNAME    the CICTO office Gmail account
#   MAIL_PASSWORD    a 16-character App Password, NOT the account password.
#                    It needs 2-Step Verification switched on first, and it is
#                    pasted without the spaces Google displays it with. It
#                    belongs in the host's .env and in no file that is in git.
#   MAIL_FROM_ADDRESS  the SAME Gmail account. Google rejects a From address it
#                    did not authenticate, at send time, with the connection
#                    reporting perfectly healthy.
#   MAIL_TIMEOUT     15
# Port 587 leaves MAIL_SCHEME unset and uses STARTTLS; for implicit TLS set
# MAIL_SCHEME=smtps and MAIL_PORT=465. There is no MAIL_ENCRYPTION key in this
# framework version -- MAIL_SCHEME replaced it.
#
# Two things to know about that account once it is live. A free Gmail account is
# capped at roughly 500 recipients a day and stops sending for 24 hours if you
# pass it -- nothing here sends in bulk, so it is headroom rather than a limit,
# but it is what breaks first if something ever loops. And every send is INLINE:
# nothing is queued, because a host with no cron runs no worker and queued mail
# would silently never send. The cost is one to three seconds on a request that
# sends, bounded by MAIL_TIMEOUT.
#
# `php artisan cicto:host-check` reads all of this back and says what is wrong.
# Its "SMTP handshake" row really connects and authenticates, sending nothing,
# so a wrong App Password fails there instead of at somebody's password reset.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Seconds to wait on the SMTP socket, read by config/mail.php (which defaults to
# 15 if this is unset). Bounded on purpose: the framework ships null, and null
# is not "no timeout" -- it is PHP's default_socket_timeout, 60 seconds on most
# builds and unlimited on some. That ceiling is how long one password-reset POST
# can hold a worker open while Gmail is unreachable.
MAIL_TIMEOUT=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- CICTO ---
# Everything below has a working default in config/cicto.php; these are the keys
# that carry a value the CLIENT decides, so they are listed here rather than left
# for somebody to discover in the config file. Re-run `php artisan config:cache`
# after changing any of them.

# The counter's published hours. Confirmed by the client on 2026-08-18 —
# Monday to Thursday really is four days, and it is not a typo for Friday.
CICTO_SUPPORT_HOURS="Monday - Thursday"
CICTO_SUPPORT_HOURS_DETAIL="7:00 AM - 6:00 PM"
# The hour a deadline is clamped to, so it lands at close of business rather
# than at midnight. 18 = 6:00 PM, matching the line above.
CICTO_BUSINESS_END_HOUR=18

# The SLA every document currently gets. Document types ship with no turnaround
# of their own because the client's answer to "how many days per type" was
# "ARO" — the records office, still to be asked — so this is the only turnaround
# in the system until they come back. Raise it here, not in the seeder.
CICTO_DEFAULT_TURNAROUND_DAYS=3

# How long an intermediate file version is kept after its document is finished.
# 1095 = three years, the floor the client gave ("3 to 5 years minimum"); set
# 1825 if the records office confirms five. Nothing is deleted at any value
# while CICTO_PRUNE_VERSIONS_ENABLED is false, which is where it stays until a
# retention policy is agreed in writing and an off-site backup exists.
CICTO_VERSION_RETENTION_DAYS=1095
CICTO_PRUNE_VERSIONS_ENABLED=false

# --- Where the documents actually live ---
# `local` is right on a VPS with a real disk, and it is the default.
#
# IT IS WRONG ON LARAVEL CLOUD, or on any container platform. Their docs are
# explicit: "environment filesystems are ephemeral ... new deployments or
# re-deployments will reset the filesystem", and each replica has its own. A
# local documents disk there means every registered document is destroyed by
# the next deploy, silently, while the database rows still point at the missing
# bytes. `php artisan cicto:host-check` warns when this pairing is live.
#
# On Laravel Cloud: attach a PRIVATE Laravel Object Storage bucket (Cloudflare
# R2, S3-compatible) and set this to s3. Use a SEPARATE bucket for backups if
# you can — an archive in the same bucket as the documents is a second copy,
# not a backup.
#
# Cloud does NOT set AWS_BUCKET or any other AWS_* variable. It sets one
# LARAVEL_CLOUD_DISK_CONFIG JSON listing every attached bucket, which
# App\Support\CloudDisk reads, so nothing below has to be copied by hand. Name
# which attached bucket each disk uses only when several are attached; with one,
# leave them unset.
CICTO_DOCUMENTS_DRIVER=local
# CICTO_DOCUMENTS_DRIVER=s3
# CICTO_DOCUMENTS_CLOUD_DISK=      # the "disk" key in LARAVEL_CLOUD_DISK_CONFIG
# CICTO_DOCUMENTS_BUCKET=          # off Cloud; defaults to AWS_BUCKET

CICTO_BACKUP_DISK_DRIVER=local
# CICTO_BACKUP_DISK_DRIVER=s3
# CICTO_BACKUP_CLOUD_DISK=
# CICTO_BACKUP_BUCKET=             # off Cloud; defaults to AWS_BUCKET
