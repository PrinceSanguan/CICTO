APP_NAME=CICTO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# CICTO runs on both PostgreSQL and MySQL/MariaDB. Uncomment one block.
# Schema is kept driver-agnostic on purpose -- see docs/DATABASE.md.

# --- PostgreSQL (default) ---
# Use a dedicated, password-authenticated role -- not a superuser and not
# `trust` auth. Postgres.app rejects `trust` for the dev server's child process,
# and no production host will offer it either. Create one with:
#   createuser --pwprompt cicto && createdb -O cicto cicto
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cicto
DB_USERNAME=cicto
DB_PASSWORD=

# --- MySQL / MariaDB ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cicto
# DB_USERNAME=root
# DB_PASSWORD=

# --- SQLite (zero-setup local dev) ---
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Outgoing mail ---
# CICTO answered client question B3 on 2026-08-20: they will not supply email
# credentials or configuration for this system, school project or not, and they
# recommend an external service -- Google SMTP by name -- for anything this
# application needs to send. So `log` is the shipping default and nothing leaves
# the server until somebody here fills the block in.
#
# What the application does while this says `log`:
#   - "Forgot password" refuses rather than pretending. No reset link is minted
#     and the page says why. The way back into a locked-out account is a Super
#     Admin setting a new password on /super-admin/users, or `php artisan
#     cicto:user <email> --reset-password` when nobody can sign in at all.
#   - Support tickets are written to the log and the page says they were not
#     delivered.
#   - Deadline notices are in-app only.
# `php artisan cicto:host-check` reports the state of all of this on the real
# host.
MAIL_MAILER=log

# Keeps rendered messages out of the shared application log while the mailer is
# `log` -- that log holds working password-reset links. See config/logging.php.
MAIL_LOG_CHANNEL=mail

# TO TURN MAIL ON, EDIT THE VALUES BELOW IN PLACE. Do not paste a second copy of
# these keys anywhere in this file: dotenv takes the LAST assignment of a
# duplicated key, so a pasted block above these lines is silently ignored and
# you end up with MAIL_MAILER=smtp still pointing at 127.0.0.1:2525 -- a mailer
# the application believes is working, minting reset tokens that go nowhere.
#
# For Google SMTP, which is what B3 recommends:
#   MAIL_MAILER      smtp
#   MAIL_HOST        smtp.gmail.com
#   MAIL_PORT        587
#   MAIL_USERNAME    the Gmail account
#   MAIL_PASSWORD    a 16-character App Password, NOT the account password.
#                    It needs 2-Step Verification switched on first, and it is
#                    pasted without the spaces Google displays it with.
#   MAIL_FROM_ADDRESS  the SAME Gmail account. Google rejects a From address it
#                    did not authenticate, at send time, with the connection
#                    reporting perfectly healthy.
# Port 587 leaves MAIL_SCHEME unset and uses STARTTLS; for implicit TLS set
# MAIL_SCHEME=smtps and MAIL_PORT=465. There is no MAIL_ENCRYPTION key in this
# framework version -- MAIL_SCHEME replaced it.
#
# `php artisan cicto:host-check` reads all of this back and says what is wrong.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- CICTO ---
# Everything below has a working default in config/cicto.php; these are the keys
# that carry a value the CLIENT decides, so they are listed here rather than left
# for somebody to discover in the config file. Re-run `php artisan config:cache`
# after changing any of them.

# The counter's published hours. Confirmed by the client on 2026-08-18 —
# Monday to Thursday really is four days, and it is not a typo for Friday.
CICTO_SUPPORT_HOURS="Monday - Thursday"
CICTO_SUPPORT_HOURS_DETAIL="7:00 AM - 6:00 PM"
# The hour a deadline is clamped to, so it lands at close of business rather
# than at midnight. 18 = 6:00 PM, matching the line above.
CICTO_BUSINESS_END_HOUR=18

# The SLA every document currently gets. Document types ship with no turnaround
# of their own because the client's answer to "how many days per type" was
# "ARO" — the records office, still to be asked — so this is the only turnaround
# in the system until they come back. Raise it here, not in the seeder.
CICTO_DEFAULT_TURNAROUND_DAYS=3

# How long an intermediate file version is kept after its document is finished.
# 1095 = three years, the floor the client gave ("3 to 5 years minimum"); set
# 1825 if the records office confirms five. Nothing is deleted at any value
# while CICTO_PRUNE_VERSIONS_ENABLED is false, which is where it stays until a
# retention policy is agreed in writing and an off-site backup exists.
CICTO_VERSION_RETENTION_DAYS=1095
CICTO_PRUNE_VERSIONS_ENABLED=false

# --- Where the documents actually live ---
# `local` is right on a VPS with a real disk, and it is the default.
#
# IT IS WRONG ON LARAVEL CLOUD, or on any container platform. Their docs are
# explicit: "environment filesystems are ephemeral ... new deployments or
# re-deployments will reset the filesystem", and each replica has its own. A
# local documents disk there means every registered document is destroyed by
# the next deploy, silently, while the database rows still point at the missing
# bytes. `php artisan cicto:host-check` warns when this pairing is live.
#
# On Laravel Cloud: attach a PRIVATE Laravel Object Storage bucket (Cloudflare
# R2, S3-compatible) and set this to s3. Cloud injects AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_BUCKET and AWS_ENDPOINT itself, so those stay
# blank here. Use a SEPARATE bucket for backups if you can — an archive in the
# same bucket as the documents is a second copy, not a backup.
CICTO_DOCUMENTS_DRIVER=local
# CICTO_DOCUMENTS_DRIVER=s3
# CICTO_DOCUMENTS_BUCKET=          # defaults to AWS_BUCKET

CICTO_BACKUP_DISK_DRIVER=local
# CICTO_BACKUP_DISK_DRIVER=s3
# CICTO_BACKUP_BUCKET=             # defaults to AWS_BUCKET
